LMS_DATABASE_URL=
JWT_SECRET=
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
# Optional public origin for uploaded files. Defaults to the request host.
# LMS_PUBLIC_URL=http://localhost:5000
# File storage provider: local (disk) or r2 (Cloudflare R2). Server-side only.
STORAGE_PROVIDER=local

# Cloudflare R2 (required when STORAGE_PROVIDER=r2). Never expose these to the browser.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# Defaults to https://<account-id>.r2.cloudflarestorage.com
# R2_ENDPOINT=
# How long a signed view/download URL stays valid (seconds).
# R2_SIGNED_URL_EXPIRES_SECONDS=900

# Upload size limits (MB) used by both validation and multipart limits.
# MAX_VIDEO_UPLOAD_MB=250
# MAX_DOCUMENT_UPLOAD_MB=25
# MAX_IMAGE_UPLOAD_MB=10
# MAX_AUDIO_UPLOAD_MB=50
# MAX_AVATAR_UPLOAD_MB=5
# LMS_TIMEZONE=Asia/Kathmandu
# USAGE_HEARTBEAT_INTERVAL_MS=45000
# USAGE_INACTIVITY_THRESHOLD_MS=300000
# USAGE_MAX_SESSION_MS=14400000
# USAGE_MAX_CHART_TRAINEES=12
